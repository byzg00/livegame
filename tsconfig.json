{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"],

    "strict": true,
    "checkJs": false,
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noErrorTruncation": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "lib": ["es6", "dom", "dom.iterable", "es2019"],
    "rootDir": ".",
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "node",
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./**.js",
    "./**.ts",
  ],
  "exclude": ["dist"]
}
